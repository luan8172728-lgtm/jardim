* {
  box-sizing: border-box;
  -webkit-tap-highlight-color: transparent;
}

html,
body {
  margin: 0;
  padding: 0;
  width: 100%;
  min-height: 100%;
  overflow: hidden;
  font-family: Georgia, "Times New Roman", serif;
  touch-action: manipulation;
}

body {
  background: linear-gradient(
    to bottom,
    #87ceeb 0%,
    #b8e6ff 45%,
    #dff7ff 62%,
    #76b852 63%,
    #3f8f3f 100%
  );
}

/* CÉU */

#sky {
  position: fixed;
  inset: 0 0 38% 0;
  overflow: hidden;
  pointer-events: none;
}

.sun {
  position: absolute;
  width: 90px;
  height: 90px;
  right: 12%;
  top: 10%;
  border-radius: 50%;
  background: #fff3a1;
  box-shadow:
    0 0 25px #fff3a1,
    0 0 60px rgba(255, 240, 120, 0.6);
}

.cloud {
  position: absolute;
  width: 120px;
  height: 40px;
  background: rgba(255, 255, 255, 0.7);
  border-radius: 50px;
}

.cloud::before,
.cloud::after {
  content: "";
  position: absolute;
  background: inherit;
  border-radius: 50%;
}

.cloud::before {
  width: 55px;
  height: 55px;
  left: 20px;
  bottom: 5px;
}

.cloud::after {
  width: 70px;
  height: 70px;
  right: 15px;
  bottom: 0;
}

.cloud1 {
  top: 18%;
  left: -20px;
  transform: scale(0.8);
}

.cloud2 {
  top: 35%;
  right: -30px;
  transform: scale(0.65);
}

/* TÍTULO */

.title {
  position: absolute;
  top: 7%;
  left: 50%;
  transform: translateX(-50%);
  width: 90%;
  text-align: center;
  color: white;
  text-shadow: 0 2px 5px rgba(0, 0, 0, 0.25);
}

.title h1 {
  margin: 0;
  font-size: clamp(30px, 8vw, 48px);
}

.title p {
  margin-top: 8px;
  font-size: clamp(14px, 4vw, 19px);
}

/* JARDIM */

#garden {
  position: fixed;
  inset: 62% 0 0 0;
  overflow: hidden;
  background:
    radial-gradient(
      ellipse at center top,
      #69a944 0%,
      #4c963b 45%,
      #32752f 100%
    );
}

.grass {
  position: absolute;
  inset: 0;
  background-image:
    radial-gradient(circle, rgba(255,255,255,0.08) 1px, transparent 1px);
  background-size: 14px 14px;
}

/* FLORES */

.flower {
  position: absolute;
  transform: translate(-50%, -100%);
  transform-origin: bottom center;
  animation: grow 0.8s cubic-bezier(.2,.8,.3,1) forwards;
  z-index: 5;
  pointer-events: none;
}

.flower-inner {
  position: relative;
  width: 42px;
  height: 75px;
}

.stem {
  position: absolute;
  width: 5px;
  height: 55px;
  left: 19px;
  bottom: 0;
  border-radius: 5px;
  background: linear-gradient(to right, #246b28, #5da64c, #246b28);
}

.leaf {
  position: absolute;
  width: 23px;
  height: 11px;
  background: #3c8738;
  border-radius: 100% 0 100% 0;
}

.leaf.left {
  left: 0;
  bottom: 19px;
  transform: rotate(-30deg);
}

.leaf.right {
  right: 0;
  bottom: 32px;
  transform: rotate(25deg) scaleX(-1);
}

.head {
  position: absolute;
  width: 42px;
  height: 42px;
  top: 0;
  left: 0;
  display: flex;
  justify-content: center;
  align-items: center;
}

/* ROSA */

.rose .head {
  border-radius: 50%;
  background:
    radial-gradient(circle at center, #8b0015 0 12%, transparent 13%),
    repeating-conic-gradient(
      #ff3150 0deg 20deg,
      #b9002b 20deg 40deg
    );
  box-shadow: 0 2px 8px rgba(80,0,0,.3);
}

/* GIRASSOL */

.sunflower .head {
  border-radius: 50%;
  background:
    radial-gradient(circle, #714500 0 25%, transparent 26%),
    repeating-conic-gradient(
      #ffd92f 0deg 12deg,
      #f4a900 12deg 20deg
    );
}

/* TULIPA */

.tulip .head {
  width: 38px;
  height: 38px;
  left: 2px;
  border-radius: 45% 45% 50% 50%;
  background: linear-gradient(135deg, #ff5470, #bd1642);
  clip-path: polygon(
    0 20%,
    25% 38%,
    50% 0,
    75% 38%,
    100% 20%,
    92% 75%,
    70% 100%,
    30% 100%,
    8% 75%
  );
}

/* ORQUÍDEA */

.orchid .head {
  background: #c56de8;
  border-radius: 55% 45% 60% 40%;
  box-shadow:
    -15px 3px 0 #d88cf0,
    15px 3px 0 #a84fd1,
    0 -14px 0 #e19bf5;
}

.orchid .head::after {
  content: "";
  width: 12px;
  height: 12px;
  border-radius: 50%;
  background: #ffd447;
}

/* LÍRIO */

.lily .head {
  background: #fff9f2;
  border-radius: 50%;
  box-shadow:
    -12px 4px 0 #fff9f2,
    12px 4px 0 #fff9f2,
    0 -13px 0 #fff9f2;
}

.lily .head::after {
  content: "";
  width: 9px;
  height: 9px;
  border-radius: 50%;
  background: #e9a22c;
}

/* CRAVO */

.carnation .head {
  border-radius: 50%;
  background:
    radial-gradient(circle, #ff6076, #d82d48);
  box-shadow:
    0 0 0 4px #f35b6e,
    0 0 0 7px #d8374f;
}

/* MARGARIDA */

.daisy .head {
  border-radius: 50%;
  background:
    radial-gradient(circle, #f2bd24 0 18%, transparent 19%),
    repeating-conic-gradient(
      white 0deg 18deg,
      #fff 18deg 36deg
    );
}

/* VIOLETA */

.violet .head {
  border-radius: 50%;
  background:
    radial-gradient(circle at center, #ffd85c 0 10%, transparent 11%),
    repeating-conic-gradient(
      #8c57d8 0deg 40deg,
      #6331a8 40deg 80deg
    );
}

/* ANIMAÇÃO */

@keyframes grow {
  0% {
    opacity: 0;
    transform: translate(-50%, -100%) scale(0);
  }

  70% {
    transform: translate(-50%, -100%) scale(1.12);
  }

  100% {
    opacity: 1;
    transform: translate(-50%, -100%) scale(1);
  }
}

/* MENSAGEM */

#message {
  position: fixed;
  z-index: 100;
  max-width: 78%;
  left: 50%;
  bottom: 15%;
  transform: translateX(-50%) translateY(20px);
  padding: 13px 19px;
  border-radius: 22px;
  background: rgba(255, 255, 255, 0.93);
  color: #49364b;
  text-align: center;
  font-size: 16px;
  line-height: 1.35;
  box-shadow: 0 5px 20px rgba(0,0,0,.18);
  opacity: 0;
  transition: all .45s ease;
  pointer-events: none;
}

#message.show {
  opacity: 1;
  transform: translateX(-50%) translateY(0);
}

/* CONTADOR */

#counter {
  position: fixed;
  right: 15px;
  top: 15px;
  z-index: 200;
  padding: 8px 13px;
  border-radius: 20px;
  background: rgba(255,255,255,.75);
  color: #5a4059;
  font-size: 14px;
  box-shadow: 0 3px 10px rgba(0,0,0,.1);
}
